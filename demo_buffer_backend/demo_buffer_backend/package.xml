<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>demo_buffer_backend</name>
  <version>0.1.0</version>
  <description>Demo buffer backend for ROS2 Buffer backend plugin system demonstration</description>

  <maintainer email="cyc@nvidia.com">CY Chen</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rcl_buffer_backend</depend>
  <depend>rosidl_runtime_cpp</depend>
  <depend>rcl_buffer_backend_registry</depend>
  <depend>pluginlib</depend>
  <depend>demo_buffer</depend>
  <depend>demo_buffer_backend_msgs</depend>
  <depend>rcutils</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
